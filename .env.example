# Database
# For Postgres.app (Mac): postgresql://YOUR_MAC_USERNAME@localhost:5432/vanilla_class_srs
# For Docker:             postgresql://srs_user:changeme@localhost:5432/vanilla_class_srs
DATABASE_URL=postgresql://user:password@localhost:5432/vanilla_class_srs

# JWT — generate strong random secrets (e.g. openssl rand -base64 64)
JWT_SECRET=
JWT_REFRESH_SECRET=

# SMTP — required for password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourschool.edu

# App
CLIENT_URL=http://localhost:5173
PORT=3000

# Server timezone — governs day/week boundaries for new-card daily limits and
# the homework weekly quota (see server/src/services/homework.service.ts).
# This deployment's teachers and students are all in Shanghai.
TZ=Asia/Shanghai
